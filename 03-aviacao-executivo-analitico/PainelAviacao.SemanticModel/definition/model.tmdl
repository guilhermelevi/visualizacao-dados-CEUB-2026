model Model
	culture: pt-BR
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: pt-BR
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

queryGroup Parametros

queryGroup Fato

queryGroup Dimensoes

queryGroup Estagio

annotation __PBI_TimeIntelligenceEnabled = 0

ref table fVoos
ref table dCalendario
ref table dAeroporto
ref table dRota
ref table dAeronave
ref table dSituacao
ref table dMotivo
ref table _Medidas

ref cultureInfo pt-BR
